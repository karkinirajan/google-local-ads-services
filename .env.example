# Copy to .env (never commit it) and fill in your own values. Every value below is a demo.

# --- Google OAuth client (Google Cloud console -> APIs & Services -> Credentials, "Web application") ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Authorised redirect URI to register there: <PUBLIC_URL>/login/callback
PUBLIC_URL=http://localhost:5001

# --- Application secrets ---
# Signs the session cookie (at least 16 characters). It must stay the same between restarts:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts the Google tokens stored in the database. Losing it makes stored tokens unreadable (users sign in again):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Optional ---
# Comma separated emails of people who may see every user's Google Ads data (everyone else sees only their own)
ADMIN_EMAILS=
DATABASE_URL=sqlite:///dashboard.db
REQUEST_TIMEOUT=20
# Google Ads API version in the URL (default v26)
GOOGLE_ADS_API_VERSION=v26
# Google ended developer tokens on 2026-09-09: they are optional and ignored. Sent only if set.
GOOGLE_ADS_DEVELOPER_TOKEN=
# The manager account to act through, if the accounts are reached via a manager. Digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Only for tests and local fakes: other Google endpoints
GOOGLE_DISCOVERY_URL=
GOOGLE_ADS_BASE_URL=
